{
  "manifest_version": 3,
  "name": "ORBIT",
  "version": "0.3.0",
  "description": "A new way to interact with the web.",
  "permissions": [
    "clipboardWrite",
    "storage"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "commands": {
    "open-orbit": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Open the ORBIT radial menu"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/ui/radial.js",
        "src/ui/quick-panel.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png"
    }
  }
}
